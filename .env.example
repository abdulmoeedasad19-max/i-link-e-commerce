# Copy this file to .env and fill in real values. Never commit .env itself
# (see .gitignore) — this file holds placeholders only.

# --- Database (Neon/PostgreSQL) ---
# Connection string for your Postgres database (Neon dashboard -> Connection Details).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth.js ---
# Random secret used to sign session tokens. Generate with: npx auth secret
AUTH_SECRET=""

# --- Transactional email (Resend) ---
# API key from https://resend.com/api-keys. Leave empty in development to
# run with email sending disabled (safe no-op) — see src/lib/email/client.ts.
RESEND_API_KEY=""
# Verified sender identity, e.g. "i.Link Systems & Solutions <orders@ilinksystems.com>".
# The domain in the address must be a domain you've added and DNS-verified
# in the Resend dashboard, or all sends will be rejected.
EMAIL_FROM_ADDRESS=""

# --- Local image uploads ---
# Subdirectory under public/ that product images are written to. Optional —
# defaults to "uploads" if unset.
UPLOAD_DIR="uploads"
